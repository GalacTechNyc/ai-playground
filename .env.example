# Mock demo, no database, no auth (data resets on restart):
BACKEND=mock

# Persistent backend — publishable key only, NO service_role key anywhere:
# BACKEND=supabase                      # Next.js API -> SECURITY DEFINER/INVOKER Postgres RPCs
# BACKEND=supabase-edge                 # alternative: proxy to ChatGPT's Edge Function gateway (supabase/functions/playground)
# NEXT_PUBLIC_BACKEND=supabase          # tells the browser to show owner sign-in
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY are also accepted server-side)
