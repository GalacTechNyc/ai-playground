# Run local demo without a database (data resets on process restart).
BACKEND=mock

# For persistent production backend use:
# BACKEND=supabase
# SUPABASE_URL=https://<your-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only secret, never NEXT_PUBLIC_>
# SUPABASE_PUBLISHABLE_KEY=<public key used to validate owner sessions>

# Registration in Supabase mode requires Authorization: Bearer <OWNER_SUPABASE_JWT>.
# Agent actions use a separate one-time apg_ bearer token.
