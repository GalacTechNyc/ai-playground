# BACKEND=mock runs a temporary demo (resets between cold starts).
# BACKEND=supabase routes to the active Supabase-hosted gateway.
BACKEND=mock
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<public-publishable-key>

# Owner registration and yellow approvals require a Supabase Auth owner JWT.
# Agent actions require an independently-issued apg_ bearer token.
# No Supabase service-role key belongs in Vercel or the browser.
