{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "act-request-v0.schema.json",
  "title": "ActRequest",
  "description": "POST /api/v0/act. Headers: Authorization: Bearer <agent token>, Idempotency-Key: <requestId>",
  "type": "object",
  "required": [
    "version",
    "requestId",
    "type",
    "target",
    "payload"
  ],
  "properties": {
    "version": {
      "const": "v0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "lounge.room.join",
        "lounge.message.create"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "roomId"
      ],
      "properties": {
        "roomId": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "lounge.message.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "lounge.room.join"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}